[
  {
    "name": "theme_info",
    "theme_name": "NoComfortDept",
    "theme_version": "1.0.0",
    "theme_author": "NoComfortDept",
    "theme_documentation_url": "https://nocomfortdept.com",
    "theme_support_url": "https://nocomfortdept.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Background",
        "default": "#0a0a0a"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#f5f5f0"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Gold)",
        "default": "#b8973a"
      },
      {
        "type": "color",
        "id": "color_urgency",
        "label": "Urgency / Alert",
        "default": "#c0392b"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_display",
        "label": "Display / Headlines",
        "default": "bebas_neue_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body text",
        "default": "inter_n4"
      }
    ]
  },
  {
    "name": "Conversion Settings",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_countdown",
        "label": "Enable countdown timers globally",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_social_proof",
        "label": "Enable social proof notifications",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_atc",
        "label": "Enable sticky Add to Cart bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_live_viewers",
        "label": "Enable live viewer count",
        "default": true
      },
      {
        "type": "range",
        "id": "default_countdown_hours",
        "label": "Default countdown duration (hours)",
        "min": 1,
        "max": 72,
        "step": 1,
        "default": 8
      }
    ]
  },
  {
    "name": "Social & Sharing",
    "settings": [
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok handle",
        "default": "@nocomfortdept"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram handle",
        "default": "@nocomfortdept"
      },
      {
        "type": "text",
        "id": "social_twitter",
        "label": "X / Twitter handle",
        "default": "@nocomfortdept"
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image"
      }
    ]
  }
]
