{
  "version": "1.0",
  "brand": "NoComfortDept",
  "description": "Task routing rules — maps incoming task keywords and types to the correct department.",

  "departments": {
    "01-brand-strategy":    { "id": "brand-strategy",    "label": "Brand Strategy",      "lead": "Brand Strategist"       },
    "02-copywriting":       { "id": "copywriting",        "label": "Copywriting",          "lead": "Head Copywriter"         },
    "03-shopify-cro":       { "id": "shopify-cro",        "label": "Shopify CRO",          "lead": "CRO Specialist"          },
