  "task_type_routes": {
    "strategy":      ["brand-strategy", "tiktok-growth", "paid-ads", "retention-email"],
    "writing":       ["copywriting", "retention-email", "paid-ads"],
    "design":        ["creative-direction", "brand-strategy"],
    "technical":     ["shopify-cro"],
    "content":       ["tiktok-growth", "creative-direction"],
    "analytics":     ["shopify-cro", "paid-ads", "retention-email"],
    "campaign":      ["paid-ads", "tiktok-growth", "retention-email"]
