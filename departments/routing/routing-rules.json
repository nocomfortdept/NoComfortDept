  "collaboration_rules": [
    {
      "trigger": "new product launch",
      "departments": ["brand-strategy", "copywriting", "creative-direction", "tiktok-growth", "shopify-cro"],
      "lead": "brand-strategy",
      "workflow": "product-launch-sequence"
    },
    {
      "trigger": "drop campaign",
      "departments": ["copywriting", "tiktok-growth", "paid-ads", "shopify-cro", "creative-direction"],
      "lead": "creative-direction",
      "workflow": "drop-campaign-sequence"
    },
    {
      "trigger": "email flow",
      "departments": ["retention-email", "copywriting"],
      "lead": "retention-email",
      "workflow": "flow-build-sequence"
    },
    {
      "trigger": "paid ad campaign",
      "departments": ["paid-ads", "copywriting", "creative-direction"],
      "lead": "paid-ads",
      "workflow": "ad-campaign-sequence"
    },
    {
      "trigger": "site audit",
      "departments": ["shopify-cro", "copywriting", "brand-strategy"],
      "lead": "shopify-cro",
      "workflow": "site-audit-sequence"
    }
  ],

  "escalation_path": {
    "unresolved": "brand-strategy",
    "cross_department": "brand-strategy",
    "urgent": "shopify-cro"
  }
}
